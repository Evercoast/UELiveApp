    float k = 3.0f; // 3 sigma covers 99.7% of the Gaussian energy

    float scale1 = k * sqrt(lambda1); // length along axis1
    float scale2 = k * sqrt(lambda2); // length along axis2

    axis1 *= scale1;
    axis2 *= scale2;
    

}

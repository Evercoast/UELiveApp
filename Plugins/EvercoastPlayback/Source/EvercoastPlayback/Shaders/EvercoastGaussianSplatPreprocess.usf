// TODO: incroporate it to DecomposeCovariance()
float DecomposeCovarianceToRadius(float3 cov2d, float det)
{
    float mid = 0.5f * (cov2d.x + cov2d.z);
    float lambda1 = mid + sqrt(max(0.1f, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1f, mid * mid - det));
    float my_radius = ceil(3.f * sqrt(max(lambda1, lambda2)));
    return my_radius;
}

float3x3 CalcCovariance2D(float3 in_scale, float4 in_quat, float4 pos_in_view, float4x4 ObjectToWorldMatrix, float4x4 ViewMatrix, float4x4 ProjMatrix, float2 view_size, float flip_y_hack)
{
    // Same implementation as original paper's computeCov3D() in forward.cu
    // Except the original's quaternion has rxyz instead of xyzw like here
    float3x3 cov;

    float3x3 S = float3x3(
        in_scale.x,  0.0f,         0.0f,       
        0.0f,         in_scale.y, 0.0f,         
        0.0f,         0.0f,         in_scale.z    
    ) ;

    float x = in_quat.x;
    float y = in_quat.y;
    float z = in_quat.z;
    float w = in_quat.w;
    // quaternion xyzw to rotation matrix R
    float3x3 R = float3x3(
        1-2*(y*y + z*z), 2*(x*y - w*z),   2*(x*z + w*y),
        2*(x*y + w*z), 1-2*(x*x + z*z),   2*(y*z - w*x),
        2*(x*z - w*y),   2*(y*z + w*x), 1-2*(x*x + y*y)
    );   

    float3x3 M = mul(S,R); 
    float3x3 Sigma = mul(transpose(M),M); //3D world covariance matrix
    // Covariance 3d = R * diag(Sx^2, Sy^2, Sz^2) * R_t     
    //float3x3 Sigma = mul(mul(transpose(R), mul(S, S)), R); // remember HLSL to run mul backwards!
    
    // End of compute covariance3D
    
    // Project covaraiance to 2D
    // The following models the steps outlined by equations 29
    // and 31 in "EWA Splatting" (Zwicker et al., 2002).  

    // NOTE: the sign of ProjMatrix[1][1] needs to be flipped for unknown reason
    float tan_fovy = 1 / ProjMatrix[1][1];
    float aspect = view_size.x / view_size.y;
    float tan_fovx = tan_fovy * aspect; // <- correct way of derive tan_fovx from tan_fovy
    
    float focal_y = view_size.y / (2.0f * tan_fovy) * flip_y_hack;
    float focal_x = view_size.x / (2.0f * tan_fovx);
    
    float4 t = pos_in_view; //pos in view with limit  
    float limFactor = 1.3f;
    float limx = limFactor * tan_fovx;
    float limy = limFactor * tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    t.x = min(limx, max(-limx, txtz)) * t.z;
    t.y = min(limy, max(-limy, tytz)) * t.z; 

    float3x3 J = float3x3(
        focal_x / t.z, 0.0f, -(focal_x * t.x) / (t.z * t.z),
        0.0f, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z),
        0, 0, 0);

    float3x3 W = mul(Matrix4x4To3x3(ObjectToWorldMatrix), Matrix4x4To3x3(ViewMatrix));
    W=transpose(W);
    
    //glm::mat3 T = W * J;
    float3x3 T = mul(J , W); 
    // Cov2D = J*W*Sigma*W_t*J_t
    // glm::mat3 cov = glm::transpose(T) * glm::transpose(Vrk) * T;  // NOTE Sigma is symmetric so there's no need to transpose
    cov = mul( mul(T ,  Sigma), transpose(T)) ;
    
    // End of covaraiance 2D projection
    return cov;
}


// Decimation
bool IsSplatKept(uint idx, float DecimatedSplatCount)
{
    if (DecimatedSplatCount <= 0.0)
        return true;
    
    float step = _SplatCount / DecimatedSplatCount;
    // Two rounds to deal with rounding issue
    uint removalSlot = round(idx / step);
    uint removeAt = round(removalSlot * step);
    // If matches then this splat is removed
    return idx != removeAt;
}


float3 ConvertSH0ToRGB(float3 diffuseSH0)
{
    // SH0 decode to diffuse
    // According to Cyclops but removed 0.5 addition for consistency with original algorithm
    return 0.2820947917739 * (diffuseSH0.xyz * 2.0 - 1.0) / 0.3;
}

float3 CalcExtraSHToRGB(float3 viewDir, DecodedSplatData decodedSplat, bool calcSHDegree1, bool calcSHDegree2, bool calcSHDegree3)
{
    float3 final_colour = 0;
    const int SH_IDX_OFFSET = -1;
    
    // Swizzle will cause handness flip, thus we have flipSH[] when decoding the coeffs
    viewDir.yz = viewDir.zy;
    
    float x = 0, y = 0, z = 0;
    float xx, yy, zz, xy, yz, xz;

    if (_SHDegree > 0 && calcSHDegree1)
    {
        x = viewDir.x;
        y = viewDir.y;
        z = viewDir.z;
        
        final_colour +=
            SH_C1 * -y * decodedSplat.sh_coeffs[1 + SH_IDX_OFFSET] +
            SH_C1 * z * decodedSplat.sh_coeffs[2 + SH_IDX_OFFSET] +
            SH_C1 * -x * decodedSplat.sh_coeffs[3 + SH_IDX_OFFSET];
    }

    if (_SHDegree > 1 && calcSHDegree2)
    {
        x = viewDir.x;
        y = viewDir.y;
        z = viewDir.z;
        
        xx = x * x;
        yy = y * y;
        zz = z * z;
        xy = x * y;
        yz = y * z;
        xz = x * z;
            
        final_colour += (
			SH_C2[0] * xy * decodedSplat.sh_coeffs[4 + SH_IDX_OFFSET] +
			SH_C2[1] * yz * decodedSplat.sh_coeffs[5 + SH_IDX_OFFSET] +
			SH_C2[2] * (2.0f * zz - xx - yy) * decodedSplat.sh_coeffs[6 + SH_IDX_OFFSET] +
			SH_C2[3] * xz * decodedSplat.sh_coeffs[7 + SH_IDX_OFFSET] +
			SH_C2[4] * (xx - yy) * decodedSplat.sh_coeffs[8 + SH_IDX_OFFSET]);
    }
            
    if (_SHDegree > 2 && calcSHDegree3)
    {
        x = viewDir.x;
        y = viewDir.y;
        z = viewDir.z;
        
        xx = x * x;
        yy = y * y;
        zz = z * z;
        xy = x * y;
        yz = y * z;
        xz = x * z;
        
        final_colour += (
			SH_C3[0] * y * (3.0f * xx - yy) * decodedSplat.sh_coeffs[9 + SH_IDX_OFFSET] +
			SH_C3[1] * xy * z * decodedSplat.sh_coeffs[10 + SH_IDX_OFFSET] +
			SH_C3[2] * y * (4.0f * zz - xx - yy) * decodedSplat.sh_coeffs[11 + SH_IDX_OFFSET] +
			SH_C3[3] * z * (2.0f * zz - 3.0f * xx - 3.0f * yy) * decodedSplat.sh_coeffs[12 + SH_IDX_OFFSET] +
			SH_C3[4] * x * (4.0f * zz - xx - yy) * decodedSplat.sh_coeffs[13 + SH_IDX_OFFSET] +
			SH_C3[5] * z * (xx - yy) * decodedSplat.sh_coeffs[14 + SH_IDX_OFFSET] +
			SH_C3[6] * x * (xx - 3.0f * yy) * decodedSplat.sh_coeffs[15 + SH_IDX_OFFSET]);
    }

    return final_colour;
}

// Dummy
[numthreads(CALC_VIEW_DATA_THREADS, 1, 1)]
void CSCalcViewDataBase(uint3 DTid : SV_DispatchThreadID)
{
}

[numthreads(CALC_VIEW_DATA_THREADS, 1, 1)]
void CSCalcViewDataForTileRenderer(uint3 DTid : SV_DispatchThreadID)
{
    uint idx = DTid.x;
    if (idx > _SplatCount)
        return;
    
    DecodedSplatData decodedSplat = DecodeSplatData(idx);
    float4 rotation = decodedSplat.quat.xzyw; // swizzle!
    float3 scale = decodedSplat.scale.xzy; // swizzle
    scale *= _SplatToUnrealUnit; // scale


    SplatViewData splatView = (SplatViewData)0;
    float4 convertedLocalPos = mul(float4(decodedSplat.pos.xyz, 1), RUB_to_FRU);
    convertedLocalPos.xyz *= _SplatToUnrealUnit;
    splatView.pos = convertedLocalPos;

    float4 pos_in_world = mul(convertedLocalPos, _MatrixObjectToWorld);
    
    float4 pos_in_view = mul(pos_in_world, _MatrixV);
    // For later run GPU sort
    // Sort front to back for tile renderer
    uint sortValueUint16 = FloatToUint16(pos_in_view.z);
    splatView.depth16 = sortValueUint16;

    float4 pos_in_clip_pre_division = mul(pos_in_view, _MatrixP);
    float4 pos_in_clip = pos_in_clip_pre_division / pos_in_clip_pre_division.w;
    // Screen space mean position
    splatView.mean_xy = (pos_in_clip.xy + 1.0) * 0.5 * _VecScreenParams.xy;
    

    // clipping
    if (pos_in_clip_pre_division.w <= 0)
    {
        _SplatViewData[idx] = (SplatViewData) 0;
        _TilesTouched[idx] = 0;
        return;
    }
        
    // if the mean is outside 30% of the screen, clip
    if (abs(pos_in_clip.x) > 1.3 || abs(pos_in_clip.y) > 1.3)
    {
        _SplatViewData[idx] = (SplatViewData) 0;
        _TilesTouched[idx] = 0;
        return;
    }


    // Get 2D covariance
    float3x3 cov = CalcCovariance2D(scale, rotation, pos_in_view, _MatrixObjectToWorld, _MatrixV, _MatrixP, _VecScreenParams.xy, 1.0);

    const float h_var = _Cov2DSqrtKernelSize;
    
    float cov2d_X = cov[0][0];
    float cov2d_Y = cov[0][1];
    float cov2d_Z = cov[1][1];

    
    float det_cov = cov2d_X * cov2d_Z - cov2d_Y * cov2d_Y;
    det_cov = max(1e-11, det_cov); // Guard against precision issues 
    
    // Apply low-pass filter, after calculating determinant
    cov2d_X += h_var;
    cov2d_Z += h_var;
    
    float det_cov_plus_h_cov = cov2d_X * cov2d_Z - cov2d_Y * cov2d_Y;

    float h_convolution_scaling = 1.0f;

    h_convolution_scaling = sqrt(max(0.000025f, det_cov / det_cov_plus_h_cov)); // max for numerical stability
    
    // Invert covariance (EWA algorithm)
    const float det = det_cov_plus_h_cov;

    if (det == 0.0f)
    {
        _SplatViewData[idx] = (SplatViewData)0;
        _TilesTouched[idx] = 0;
        return;
    }
    
    float det_inv = 1.0 / det;
    
    float3 conic = float3(cov2d_Z, -cov2d_Y, cov2d_X) * det_inv;
    
    // Now axis1 and axis2 seems to be correct with proper 3-Sigma coverage
    float3 cov2d = float3(cov2d_X, cov2d_Y, cov2d_Z);

    splatView.conic = float4(conic, decodedSplat.col_a.a * h_convolution_scaling);
    
    // Get tile index range, and stored into SplatView for later sorting purpose with tile_id
    uint2 TileIdxRangeMin, TileIdxRangeMax;
    
    // TODO: precompute this
    uint W = (uint) _VecScreenParams.x;
    uint H = (uint) _VecScreenParams.y;
    uint horizontal_tile_count = (W + TILE_SIZE - 1) / TILE_SIZE; // RoundUp(W / TileSize)
    uint vertical_tile_count = (H + TILE_SIZE - 1) / TILE_SIZE; // RoundUp(W / TileSize)
    
    // Radius for true volume rendering
    float my_radius = DecomposeCovarianceToRadius(cov2d, det);
    CalcTileIndexRange(splatView.mean_xy, my_radius, TileIdxRangeMin, TileIdxRangeMax, uint2(TILE_SIZE, TILE_SIZE), uint2(horizontal_tile_count, vertical_tile_count));
    splatView.radii_clipz = float2(my_radius, pos_in_clip.z);
    
    float3 final_colour = 0;
    float COLOUR_OFFSET = 0.5;
    
    if (_SHRender.x > 0)
    {
        final_colour += ConvertSH0ToRGB(decodedSplat.col_a.xyz);
    }
     
    if (dot(_SHRender.yzw, _SHRender.yzw) > 0)
    {
        float3 viewDir = normalize(pos_in_world.xyz - _CameraPosWS);
        viewDir = mul(viewDir, (float3x3)_MatrixWorldToObject); // viewDir needs to be in obj space
        final_colour += CalcExtraSHToRGB(viewDir, decodedSplat, _SHRender.y > 0, _SHRender.z > 0, _SHRender.w > 0);
    }
    
    final_colour += COLOUR_OFFSET;
    
    splatView.diffuse_opacity.rgb = final_colour;
    
    // sRGB is a gamma-encoded color space (approx gamma 2.2). To convert from linear to sRGB, Unreal applies a gamma correction, roughly
    // sRGB = pow(linear, 1/2.2)
    // So usually Unreal expect an input of linear colour so that the gamma correction to sRGB goes as it expected.
    // But here we recon the Gaussian using sRGB colours so we need to write raw sRGB value too, so we'll have to do the inversion like pow(color, 2.2)
    // However the inverse Gamma compensation will be handled in Material Editor, for debugging reason
    
    // FIXME: for tile renderer this Gamma compensation will either be here or in the tile renderer
    splatView.diffuse_opacity.a = decodedSplat.col_a.a * h_convolution_scaling;
    
    // Store how many tiles covered by this splat
    splatView.tile_idx_ranges.xy = TileIdxRangeMin.xy;
    splatView.tile_idx_ranges.zw = TileIdxRangeMax.xy;
    
    _TilesTouched[idx] = (TileIdxRangeMax.y - TileIdxRangeMin.y) * (TileIdxRangeMax.x - TileIdxRangeMin.x);
    
    _SplatViewData[idx] = splatView;

    // NOT USED BY TILE RENDERER:
    //splatView.axis1
    //splatView.axis2
    //splatView.clip_pos
    //_SortKeyList_A
    
}



[numthreads(CALC_VIEW_DATA_THREADS, 1, 1)]
void CSCalcViewDataForQuadRenderer(uint3 DTid : SV_DispatchThreadID)
{
    uint idx = DTid.x;
    if (idx > _SplatCount)
        return;
    
    float decimatedSplatCount = round(_SplatCount * _ClipOverrideDecimation.y);
    if (!IsSplatKept(idx, decimatedSplatCount))
    {
        _SplatViewData[idx] = (SplatViewData) 0;
        return;
    }
    
    DecodedSplatData decodedSplat = DecodeSplatData(idx);
    float4 rotation = decodedSplat.quat.xzyw; // swizzle!
    float3 scale = decodedSplat.scale.xzy; // swizzle
    scale *= _SplatToUnrealUnit; // scale


    SplatViewData splatView = (SplatViewData) 0;
    float4 convertedLocalPos = mul(float4(decodedSplat.pos.xyz, 1), RUB_to_FRU);
    convertedLocalPos.xyz *= _SplatToUnrealUnit;
    splatView.pos = convertedLocalPos;

    float4 pos_in_world = mul(convertedLocalPos, _MatrixObjectToWorld);
    
    float4 pos_in_view = mul(pos_in_world, _MatrixV);
    // For later run GPU sort
    // Sort back to front for quad renderer
    uint sortValueUint32 = FloatToSortableUint(pos_in_view.z);
    
    int SO = _SortingOrder;
    _SortKeyList_A[idx] = SO * 0xffffffff + (1 - SO * 2) * sortValueUint32;
    
    // When SO = 0 or 1, equivalent to:
    /*
    // From back to front (painter's algorithm)
    if (_SortingOrder > 0)
    {
        _SortKeyList_A[idx] = 0xffffffff - sortValueUint32;
    }
    // From front to back (OneMiusDstAlpha, One blending trick)
    else
    {
        _SortKeyList_A[idx] = sortValueUint32;
    }
    */

    float4 pos_in_clip_pre_division = mul(pos_in_view, _MatrixP);
    float4 pos_in_clip = pos_in_clip_pre_division / pos_in_clip_pre_division.w;
    
    splatView.clip_pos = pos_in_clip_pre_division.xyz;
    splatView.radii_clipz = pos_in_clip_pre_division.zw;
    // Screen space mean position
    splatView.mean_xy = (pos_in_clip.xy + 1.0) * 0.5 * _VecScreenParams.xy;
    

    // clipping
    if (_ClipOverrideDecimation.x <= 0) // only when clipping is needed
    {
        if (pos_in_clip_pre_division.w <= 0)
        {
            _SplatViewData[idx] = (SplatViewData) 0;
            return;
        }
        
        // if the mean is outside 30% of the screen, clip
        if (abs(pos_in_clip.x) > 1.3 || abs(pos_in_clip.y) > 1.3)
        {
            _SplatViewData[idx] = (SplatViewData) 0;
            return;
        }
    }


    // Get 2D covariance
    float3x3 cov = CalcCovariance2D(scale, rotation, pos_in_view, _MatrixObjectToWorld, _MatrixV, _MatrixP, _VecScreenParams.xy, -1.0);

    const float h_var = _Cov2DSqrtKernelSize;
    
    float cov2d_X = cov[0][0];
    float cov2d_Y = cov[0][1];
    float cov2d_Z = cov[1][1];

    
    float det_cov = cov2d_X * cov2d_Z - cov2d_Y * cov2d_Y;
    det_cov = max(1e-11, det_cov); // Guard against precision issues 
    
    // Apply low-pass filter, after calculating determinant
    cov2d_X += h_var;
    cov2d_Z += h_var;
    
    float det_cov_plus_h_cov = cov2d_X * cov2d_Z - cov2d_Y * cov2d_Y;

    float h_convolution_scaling = 1.0f;

    h_convolution_scaling = sqrt(max(0.000025f, det_cov / det_cov_plus_h_cov)); // max for numerical stability
    
    // Invert covariance (EWA algorithm)
    const float det = det_cov_plus_h_cov;

    if (det == 0.0f)
    {
        _SplatViewData[idx] = (SplatViewData) 0;
        return;
    }
    
    float det_inv = 1.0 / det;
    
    float3 conic = float3(cov2d_Z, -cov2d_Y, cov2d_X) * det_inv;
    
    // Now axis1 and axis2 seems to be correct with proper 3-Sigma coverage
    float3 cov2d = float3(cov2d_X, cov2d_Y, cov2d_Z);
    DecomposeCovariance(cov2d, splatView.axis1, splatView.axis2); // both version work
    //DecomposeCovariance_2(cov2d_X, cov2d_Y, cov2d_Z, splatView.axis1, splatView.axis2);
        
    const float extraScale = _SplatExtraScale;
    // This will affect the quad size but will not affect the calculation of mahal distance falloff
    // With the 3-sigma axis correction the extra scale hack should be useless, kept here only for debug reason
    // Axis for native quad-based splat realtime rendering
    splatView.axis1 = splatView.axis1 * pos_in_view.z / _VecScreenParams.xy * extraScale;
    splatView.axis2 = splatView.axis2 * pos_in_view.z / _VecScreenParams.xy * extraScale;

    splatView.conic = float4(conic, decodedSplat.col_a.a * h_convolution_scaling);
    
    // Get tile index range, and stored into SplatView for later sorting purpose with tile_id
    uint2 TileIdxRangeMin, TileIdxRangeMax;
    
    float3 final_colour = 0;
    float COLOUR_OFFSET = 0.5;
    
    if (_SHRender.x > 0)
    {
        final_colour += ConvertSH0ToRGB(decodedSplat.col_a.xyz);
    }
     
    if (dot(_SHRender.yzw, _SHRender.yzw) > 0)
    {
        float3 viewDir = normalize(pos_in_world.xyz - _CameraPosWS);
        viewDir = mul(viewDir, (float3x3) _MatrixWorldToObject); // viewDir needs to be in obj space
        final_colour += CalcExtraSHToRGB(viewDir, decodedSplat, _SHRender.y > 0, _SHRender.z > 0, _SHRender.w > 0);
    }
    
    final_colour += COLOUR_OFFSET;
    
    splatView.diffuse_opacity.rgb = final_colour;
    
    // sRGB is a gamma-encoded color space (approx gamma 2.2). To convert from linear to sRGB, Unreal applies a gamma correction, roughly
    // sRGB = pow(linear, 1/2.2)
    // So usually Unreal expect an input of linear colour so that the gamma correction to sRGB goes as it expected.
    // But here we recon the Gaussian using sRGB colours so we need to write raw sRGB value too, so we'll have to do the inversion like pow(color, 2.2)
    // However the inverse Gamma compensation will be handled in Material Editor, for debugging reason
    
    // FIXME: for tile renderer this Gamma compensation will either be here or in the tile renderer
    splatView.diffuse_opacity.a = decodedSplat.col_a.a * h_convolution_scaling;
    
    _SplatViewData[idx] = splatView;

    // NOT USED IN QUAD RENDERER:
    //splatView.depth16
    //splatView.tile_idx_ranges;
    //_TilesTouched
}
